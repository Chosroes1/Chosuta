set(CHOSUTA_ZLIB_SOURCE_DIR "" CACHE PATH "Complete zlib 1.3.2 source tree, including contrib/minizip")
set(CHOSUTA_ZIP_PROVIDER "system-minizip-zlib")
if(CHOSUTA_ZLIB_SOURCE_DIR OR CHOSUTA_DOWNLOAD_DEPENDENCIES)
 if(CHOSUTA_ZLIB_SOURCE_DIR)
  get_filename_component(zip_source "${CHOSUTA_ZLIB_SOURCE_DIR}" ABSOLUTE)
 else()
  # A single download attempt; fail promptly on network/DNS errors.
  set(zip_cache "${CMAKE_BINARY_DIR}/_deps/chosuta-zlib-1.3.2")
  file(MAKE_DIRECTORY "${zip_cache}")
  set(zip_archive "${zip_cache}/zlib-1.3.2.tar.gz")
  set(zip_hash "bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16")
  if(NOT EXISTS "${zip_archive}")
   file(DOWNLOAD "https://zlib.net/zlib-1.3.2.tar.gz" "${zip_archive}.download"
    STATUS zip_download_status TLS_VERIFY ON TIMEOUT 20 INACTIVITY_TIMEOUT 10)
   list(GET zip_download_status 0 zip_download_code)
   if(NOT zip_download_code EQUAL 0)
    file(REMOVE "${zip_archive}.download")
    message(FATAL_ERROR "zlib source download failed: ${zip_download_status}. Supply CHOSUTA_ZLIB_SOURCE_DIR for an offline build.")
   endif()
   file(RENAME "${zip_archive}.download" "${zip_archive}")
  endif()
  file(SHA256 "${zip_archive}" zip_actual_hash)
  if(NOT zip_actual_hash STREQUAL zip_hash)
   message(FATAL_ERROR "zlib 1.3.2 cached archive SHA-256 mismatch: ${zip_archive}")
  endif()
  set(zip_source "${zip_cache}/zlib-1.3.2")
  if(NOT EXISTS "${zip_source}/zlib.h")
   file(ARCHIVE_EXTRACT INPUT "${zip_archive}" DESTINATION "${zip_cache}")
  endif()
 endif()
 if(NOT EXISTS "${zip_source}/contrib/minizip/unzip.c" OR NOT EXISTS "${zip_source}/LICENSE")
  message(FATAL_ERROR "Expected complete zlib 1.3.2 source including contrib/minizip: ${zip_source}")
 endif()
 file(READ "${zip_source}/zlib.h" zip_header)
 if(NOT zip_header MATCHES "#define ZLIB_VERSION[ \t]+\"1\\.3\\.2\"")
  message(FATAL_ERROR "CHOSUTA_ZLIB_SOURCE_DIR must contain zlib 1.3.2")
 endif()
 enable_language(C)
 # Only the inflate/checksum side is needed. No ZIP writer, crypto, bzip2,
 # command line programs, tests or upstream install/global CPack configuration.
 add_library(chosuta_inflate STATIC
  "${zip_source}/adler32.c" "${zip_source}/crc32.c" "${zip_source}/inflate.c"
  "${zip_source}/inftrees.c" "${zip_source}/inffast.c" "${zip_source}/zutil.c")
 target_include_directories(chosuta_inflate PUBLIC "${zip_source}")
 add_library(chosuta_zip STATIC "${zip_source}/contrib/minizip/unzip.c" "${zip_source}/contrib/minizip/ioapi.c")
 target_include_directories(chosuta_zip PUBLIC "${zip_source}/contrib/minizip")
 target_link_libraries(chosuta_zip PUBLIC chosuta_inflate)
 target_compile_definitions(chosuta_zip PRIVATE NOUNCRYPT)
 foreach(zip_target chosuta_inflate chosuta_zip)
  set_target_properties(${zip_target} PROPERTIES AUTOMOC OFF AUTORCC OFF POSITION_INDEPENDENT_CODE ON)
  if(MSVC)
   target_compile_definitions(${zip_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
  endif()
 endforeach()
 set(CHOSUTA_ZIP_PROVIDER "source-static-minizip-zlib-1.3.2-inflate-only")
 if(WIN32)
  set(zip_source_destination "dependency-sources/zlib-1.3.2")
 else()
  set(zip_source_destination "share/chosuta/dependency-sources/zlib-1.3.2")
 endif()
 install(DIRECTORY "${zip_source}/" DESTINATION "${zip_source_destination}" PATTERN ".git" EXCLUDE PATTERN ".github" EXCLUDE)
else()
 if(WIN32)
  message(FATAL_ERROR "Windows ZIP support requires CHOSUTA_ZLIB_SOURCE_DIR or explicit CHOSUTA_DOWNLOAD_DEPENDENCIES.")
 endif()
 find_package(ZLIB 1.2.13 REQUIRED)
 find_path(CHOSUTA_MINIZIP_INCLUDE_DIR unzip.h PATH_SUFFIXES minizip REQUIRED)
 find_library(CHOSUTA_MINIZIP_LIBRARY NAMES minizip REQUIRED)
 add_library(chosuta_zip UNKNOWN IMPORTED)
 set_target_properties(chosuta_zip PROPERTIES IMPORTED_LOCATION "${CHOSUTA_MINIZIP_LIBRARY}"
  INTERFACE_INCLUDE_DIRECTORIES "${CHOSUTA_MINIZIP_INCLUDE_DIR}" INTERFACE_LINK_LIBRARIES ZLIB::ZLIB)
endif()
